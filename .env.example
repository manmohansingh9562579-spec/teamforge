MONGODB_URI=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SMTP sender for password reset emails (Gmail works with an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Defaults to the public Judge0 CE runner. If you use an authenticated
# Judge0 host, set its endpoint and token here; never expose the token to clients.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
